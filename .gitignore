# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# polyscope
.polyscope.ini
imgui.ini

# Virtual environments
.venv
.python-version

# Datasets (may be a real directory or a symlink to a data drive;
# no trailing slash, so this matches both)
/datasets

# Generated configs (recreate with: uv run python scripts/generate_*_configs.py)
config/thingi10k/*/create_rkpm.yaml
config/thingi10k/*/create_mlp.yaml
config/thingi10k/*/sim_*.yaml
config/simready/*/create_rkpm.yaml
config/simready/*/create_mlp.yaml
config/simready/*/sim_*.yaml

# Local notes
tmp/
todo.txt
work.md

# Thingi10K boundary conditions are generated by data/export_thingi10k.py
# rather than shipped, so the repo does not redistribute geometry derived
# from third-party Thingi10K models.
config/thingi10k/*/*.npz
